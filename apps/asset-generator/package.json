    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@absolution/shared-types": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "lucide-react": "^1.61.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
