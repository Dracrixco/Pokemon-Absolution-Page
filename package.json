{
  "name": "pokemon-absolution",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @absolution/web --filter @absolution/server dev",
    "dev:web": "pnpm --filter @absolution/web dev",
    "dev:server": "pnpm --filter @absolution/server dev",
    "dev:generator": "pnpm --filter @absolution/asset-generator dev",
    "build": "pnpm -r build",
    "check-types": "pnpm -r check-types",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm --filter @absolution/web lint",
    "start": "pnpm --filter @absolution/web start",
    "preview": "pnpm --filter @absolution/web preview",
    "prettier": "prettier --write . --ignore-path .prettierignore"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
