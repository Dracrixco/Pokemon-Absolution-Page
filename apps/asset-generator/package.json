{
  "name": "@absolution/asset-generator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc --noEmit && vite build",
